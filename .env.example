# Telegram Bot Token (from @BotFather) - REQUIRED
BOT_TOKEN=12345678:ABC-DEF1234ghIkl-zyx57W2P0s

# Web service port for Render health checks (default: 8080)
PORT=8080

# Optional: Restrict bot usage to specific Telegram User IDs (comma-separated)
# Leave blank to allow anyone to use the bot
# ALLOWED_USERS=123456789,987654321

# Maximum download file size in MB (Telegram bot standard API limit is 50MB)
MAX_FILE_SIZE_MB=50

# Maximum concurrent downloads (default: 1 for Render Free tier 512MB RAM)
MAX_CONCURRENT_DOWNLOADS=1
